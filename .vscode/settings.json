{
  // ---------------------------------------------------------------------
  // PATH fix (LINUX REMOTE copy: TinyTeX in ~/.local/bin;
  // the macOS original is saved as settings.json.mac.bak).
  //
  // /Library/TeX/texbin reaches the shell via /etc/paths.d/TeX, which is
  // read by path_helper during shell startup.  VS Code launched from the
  // Dock never runs a shell, so it inherits launchd's PATH and cannot see
  // any TeX binary -- hence "spawn latexmk ENOENT".
  //
  // Absolute `command' paths are not sufficient on their own: latexmk
  // spawns pdflatex and biber by bare name, so each tool also needs a PATH
  // in its environment.
  // ---------------------------------------------------------------------
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "/homes/55/josephmiller/.local/bin/latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-f",
        "-pdf",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ],
      "env": { "PATH": "/homes/55/josephmiller/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin" }
    },
    {
      "name": "latexmk_rconly",
      "command": "/homes/55/josephmiller/.local/bin/latexmk",
      "args": ["%DOC%"],
      "env": { "PATH": "/homes/55/josephmiller/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin" }
    },
    {
      "name": "pdflatex",
      "command": "/homes/55/josephmiller/.local/bin/pdflatex",
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "%DOC%"],
      "env": { "PATH": "/homes/55/josephmiller/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin" }
    },
    {
      "name": "biber",
      "command": "/homes/55/josephmiller/.local/bin/biber",
      "args": ["%DOCFILE%"],
      "env": { "PATH": "/homes/55/josephmiller/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin" }
    }
  ],

  // Only expose recipes whose tools are defined above.
  "latex-workshop.latex.recipes": [
    { "name": "latexmk", "tools": ["latexmk"] },
    { "name": "latexmk (latexmkrc)", "tools": ["latexmk_rconly"] },
    { "name": "pdflatex -> biber -> pdflatex * 2",
      "tools": ["pdflatex", "biber", "pdflatex", "pdflatex"] }
  ],

  // These helpers are invoked by bare name too, and hit the same problem.
  "latex-workshop.kpsewhich.path": "/homes/55/josephmiller/.local/bin/kpsewhich",
  "latex-workshop.synctex.path": "/homes/55/josephmiller/.local/bin/synctex",
  "latex-workshop.texcount.path": "/homes/55/josephmiller/.local/bin/texcount",
  "latex-workshop.latexindent.path": "/homes/55/josephmiller/.local/bin/latexindent",
  "latex-workshop.formatting.latexindent.path": "/homes/55/josephmiller/.local/bin/latexindent",
  "latex-workshop.texdoc.path": "/homes/55/josephmiller/.local/bin/texdoc",

  // ---------------------------------------------------------------------
  // Ghost text off for LaTeX: the grey italic continuation that appears
  // ahead of the cursor.  Provider-agnostic, so it covers Copilot and
  // anything else registering an inline-completion provider.
  //
  // The completion POPUP is deliberately left on -- it is what supplies
  // citation keys from references.bib, \ref labels, and command names.
  // ---------------------------------------------------------------------
  "[latex]": {
    "editor.inlineSuggest.enabled": false,

    // Soft-wrap long lines at the window edge (prose reads better wrapped;
    // this is display-only and never inserts real line breaks).
    "editor.wordWrap": "on"
  },

  // Mirrors Copilot's own defaults, with latex added.
  "github.copilot.enable": {
    "*": true,
    "latex": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },

  // Draft mode: the source currently has known errors; build to completion
  // (-f above) and keep the "Recipe terminated" toasts quiet. Errors remain
  // visible in the Problems panel and the compiler log when wanted.
  "latex-workshop.message.error.show": false,
  "latex-workshop.message.warning.show": false,

  // Rebuild on save; jump the PDF to the cursor after each build.
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.synctex.afterBuild.enabled": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1500
}
